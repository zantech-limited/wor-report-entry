# Copy to .env. The Compose ports bind only to this computer.
# Set your own secrets before using real data.
ADMIN_TOKEN=replace-with-a-long-random-token
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-database-password
POSTGRES_PASSWORD=replace-with-a-database-password

# Optional: environment settings override Admin's saved storage connection.
# DB_ENGINE=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=service_report
# DB_USER=service_desk
# DB_PASSWORD=replace-with-a-database-password
# DB_TLS=false

# Supabase shared database: use Connect > Session pooler parameters.
# DB_ENGINE=supabase
# DB_HOST=aws-0-your-region.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.your-project-reference
# DB_PASSWORD=your-database-password
# DB_TLS=true
# DB_CODE=12345
# DB_SSL_CA=optional PEM server root certificate
# Obtain DB_CODE from the original instance's Admin page. It is an identifier,
# not a password. Leave it unset only when initializing the original database.

# Named accounts are enabled by default. Use a long stable secret, backed up privately.
# APP_URL=https://wor-report-entry.vercel.app
# AUTH_SECRET=generate-at-least-32-random-characters
# CRON_SECRET=generate-another-long-random-secret
# Vercel production (wor-report-entry, Node.js 24.x from package.json engines):
# Required:
#   APP_URL=https://wor-report-entry.vercel.app
#   AUTH_SECRET=at least 32 random characters; keep the same value across redeploys
#   ADMIN_TOKEN=long random secret; used once at /setup to create the first Admin
#   CRON_SECRET=long random secret; Vercel sends it as Authorization: Bearer to /api/cron/mail
#   DB_ENGINE=supabase
#   DB_HOST=aws-0-your-region.pooler.supabase.com
#   DB_PORT=6543
#   DB_NAME=postgres
#   DB_USER=postgres.your-project-reference
#   DB_PASSWORD=the database password, not a Supabase API key
#   DB_TLS=true
#   DB_CODE=66208
# Optional:
#   DB_SSL_CA=PEM server root certificate when the runtime does not trust Supabase
# Use the Supabase transaction pooler (port 6543) and a small pool. SQLite is refused on Vercel.
# Keep DB_CODE=66208 only when connecting to that existing database.
# SMTP is configured privately in Admin and encrypted with AUTH_SECRET.
# Preview deployments must use an isolated database, their own APP_URL, and test SMTP.
# Never point untrusted preview deployments at the production database.
# The daily cron in vercel.json calls GET /api/cron/mail. Hobby plans only allow daily crons.
